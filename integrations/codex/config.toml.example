# Añadir a ~/.codex/config.toml para usar el cliente CIMD publicado por Nappai.
# El callback debe figurar exactamente en el documento oauth.json.
[mcp_servers.icjce]
url = "https://icjce-api.nappai.tech/api/v2/mcp/6efc4933-077e-4dc0-b8d0-2a5cb46bf54a/mcp"

[mcp_servers.icjce.oauth]
client_id = "https://icjce-api.nappai.tech/mcp/metadata/oauth.json"
callback_port = 51217
callback_url = "http://127.0.0.1:51217/callback"
